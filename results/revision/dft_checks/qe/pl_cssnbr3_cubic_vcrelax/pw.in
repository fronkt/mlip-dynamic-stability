&CONTROL
  ! job pl_cssnbr3_cubic_vcrelax, written by scripts/dft_checks.py
  ! pseudo_dir is taken from $ESPRESSO_PSEUDO (exported by scripts/box/qe_queue.sh)
  calculation = 'vc-relax'
  prefix = 'pwscf'
  outdir = './scratch'
  disk_io = 'low'
  tprnfor = .true.
  tstress = .true.
  verbosity = 'low'
  etot_conv_thr = 1.0d-6
  forc_conv_thr = 1.0d-4
  nstep = 150
/
&SYSTEM
  ibrav = 0
  nat = 5
  ntyp = 3
  ecutwfc = 60.0
  ecutrho = 480.0
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.005
/
&ELECTRONS
  conv_thr = 5.000d-10
  mixing_beta = 0.4
  electron_maxstep = 200
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  press = 0.0
  press_conv_thr = 0.1
/
ATOMIC_SPECIES
Cs 132.9055 Cs_pbe_v1.uspp.F.UPF
Sn 118.7100 Sn_pbe_v1.uspp.F.UPF
Br 79.9040 br_pbe_v1.4.uspp.F.UPF
CELL_PARAMETERS angstrom
  5.8000000000 0.0000000000 0.0000000000
  0.0000000000 5.8000000000 0.0000000000
  0.0000000000 0.0000000000 5.8000000000
ATOMIC_POSITIONS angstrom
Cs 0.0000000000 0.0000000000 0.0000000000
Sn 2.9000000000 2.9000000000 2.9000000000
Br 0.0000000000 2.9000000000 2.9000000000
Br 2.9000000000 0.0000000000 2.9000000000
Br 2.9000000000 2.9000000000 0.0000000000
K_POINTS automatic
5 5 5 0 0 0
