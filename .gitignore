# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv*/
venv*/
env-*/

# Results: keep the canonical ledger (small, the deliverable), ignore bulk artifacts
results/**/*.parquet
results/**/*.h5
results/**/*.npy
results/runs/
results/cache/
!results/ledger.parquet
!results/ledger.jsonl
*.traj
phonopy_disp.yaml
FORCE_SETS
SPOSCAR
POSCAR-*

# SSCHA / TDEP scratch
sscha_ensembles/
*.tdep
infile.*
outfile.*

# OS / editor
.DS_Store
Thumbs.db
.ipynb_checkpoints/

# Secrets / keys
*.env
.env
mp_api_key.txt

!results/convergence_study.parquet

# Revision compute: raw SSCHA ensembles are deposited on Zenodo, not in git
results/revision/*/work/
results/revision/*/locks/
results/revision/sscha_seeds/_dryrun/
# Revision DFT: unselected C3a inputs (never run), pw.x stderr (gfortran IEEE notes only),
# and the queue's byte-identical pw.in copies; the full box tree is in the raw archive
results/revision/dft/qe/ax_*/
results/revision/dft/qe/*/pw.err
results/revision/dft/qe/*/pw.in.ran
